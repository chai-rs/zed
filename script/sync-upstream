#!/usr/bin/env bash
#
# Sync this fork with upstream zed-industries/zed.
#
# Default behavior:
#   1. Fetch upstream/main
#   2. Fast-forward local main to upstream/main
#   3. Push updated main to origin
#   4. Rebase the named feature branch (default: auto_prompt) onto main
#
# Usage:
#   script/sync-upstream                    # rebase auto_prompt onto upstream/main
#   script/sync-upstream <branch>           # rebase <branch> onto upstream/main
#   script/sync-upstream --no-rebase        # only sync main, leave feature branches alone
#   script/sync-upstream --dry-run          # show what would happen, do nothing
#
# Safety:
#   - Aborts if working tree is dirty.
#   - Aborts if upstream remote is missing or doesn't point at zed-industries.
#   - Uses --ff-only on main; if it would not fast-forward, the script bails
#     so you can resolve manually instead of silently rewriting your main.
#   - Rebase failures leave you in the rebase state for manual resolution.

set -euo pipefail

FEATURE_BRANCH="auto_prompt"
DO_REBASE=true
DRY_RUN=false

while [ $# -gt 0 ]; do
    case "$1" in
        --no-rebase) DO_REBASE=false; shift ;;
        --dry-run)   DRY_RUN=true; shift ;;
        -h|--help)
            sed -n '3,22p' "$0"
            exit 0
            ;;
        -*)
            echo "Unknown flag: $1" >&2
            exit 2
            ;;
        *)
            FEATURE_BRANCH="$1"; shift
            ;;
    esac
done

run() {
    if [ "$DRY_RUN" = true ]; then
        echo "DRY-RUN: $*"
    else
        echo "+ $*"
        "$@"
    fi
}

# Verify upstream remote exists and looks correct.
upstream_url=$(git remote get-url upstream 2>/dev/null || true)
if [ -z "$upstream_url" ]; then
    echo "ERROR: 'upstream' remote not configured." >&2
    echo "  Run: git remote add upstream https://github.com/zed-industries/zed.git" >&2
    exit 1
fi
case "$upstream_url" in
    *zed-industries/zed*) ;;
    *)
        echo "WARNING: upstream is $upstream_url" >&2
        echo "  Expected something matching zed-industries/zed." >&2
        echo "  Continue anyway? [y/N]"
        read -r ans
        [[ "$ans" =~ ^[Yy]$ ]] || exit 1
        ;;
esac

# Refuse to run with uncommitted changes.
if [ "$DRY_RUN" = false ] && ! git diff-index --quiet HEAD --; then
    echo "ERROR: Working tree has uncommitted changes. Stash or commit first." >&2
    git status --short
    exit 1
fi

original_branch=$(git symbolic-ref --short HEAD)

echo "==> Fetching upstream"
run git fetch upstream --prune --tags

echo "==> Fast-forwarding main to upstream/main"
run git checkout main
if ! run git merge --ff-only upstream/main; then
    echo "ERROR: main has diverged from upstream/main." >&2
    echo "  Resolve manually, or reset with: git reset --hard upstream/main" >&2
    exit 1
fi

echo "==> Pushing main to origin"
run git push origin main

if [ "$DO_REBASE" = false ]; then
    echo "==> Skipping feature-branch rebase (--no-rebase)"
    run git checkout "$original_branch"
    exit 0
fi

if ! git show-ref --verify --quiet "refs/heads/$FEATURE_BRANCH"; then
    echo "==> Branch '$FEATURE_BRANCH' not found, nothing to rebase"
    run git checkout "$original_branch"
    exit 0
fi

echo "==> Rebasing $FEATURE_BRANCH onto main"
run git checkout "$FEATURE_BRANCH"
if ! run git rebase main; then
    echo "" >&2
    echo "Rebase hit conflicts. Fix files, then:" >&2
    echo "  git add <files>" >&2
    echo "  git rebase --continue" >&2
    echo "Or abort with:  git rebase --abort" >&2
    exit 1
fi

echo "==> Done. To publish the rebased branch (force-push, destructive):"
echo "  git push --force-with-lease origin $FEATURE_BRANCH"
